<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude the legacy RA token and Play ownership cache; entitlements are restored from the Play account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="retroachievements.xml" />
        <exclude domain="sharedpref" path="gbframe_visual_customization.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="retroachievements.xml" />
        <exclude domain="sharedpref" path="gbframe_visual_customization.xml" />
    </device-transfer>
</data-extraction-rules>
